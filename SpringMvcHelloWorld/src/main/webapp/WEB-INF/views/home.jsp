    <main>
        <section id="home" class="hero">
            <div class="hero-bg"></div>
            <div class="container">
                <div class="hero-content">
                    <h2>Sports Venue Booking Made Simple</h2>
                    <p class="hero-subtitle">Book venues for 12+ sports including futsal, cricket, badminton, basketball, swimming, volleyball, tennis and more across Nepal with just a few clicks</p>
                    <div class="cta-buttons">
                        <button class="btn-primary">&#x1F50D; Find Venues</button>
                        <button class="btn-secondary">&#x1F3DF;&#xFE0F; List Your Venue</button>
                    </div>
                </div>
            </div>
        </section>

        <section id="sports" class="sports-section">
            <div class="container">
                <h2>Sports We Cover</h2>
                <div class="sports-grid">
                    <div class="sport-card">
                        <div class="sport-icon">&#x26BD;</div>
                        <h3>Futsal</h3>
                        <p>Indoor football venues across Nepal</p>
                    </div>
                    <div class="sport-card">
                        <div class="sport-icon">&#x1F3CF;</div>
                        <h3>Cricket</h3>
                        <p>Cricket grounds and practice nets</p>
                    </div>
                    <div class="sport-card">
                        <div class="sport-icon">&#x1F3F8;</div>
                        <h3>Badminton</h3>
                        <p>Indoor badminton courts</p>
                    </div>
                    <div class="sport-card">
                        <div class="sport-icon">&#x1F3C0;</div>
                        <h3>Basketball</h3>
                        <p>Basketball courts and facilities</p>
                    </div>
                    <div class="sport-card">
                        <div class="sport-icon">&#x1F3CA;</div>
                        <h3>Swimming</h3>
                        <p>Swimming pools and aquatic centers</p>
                    </div>
                    <div class="sport-card">
                        <div class="sport-icon">&#x1F3D0;</div>
                        <h3>Volleyball</h3>
                        <p>Indoor and beach volleyball courts</p>
                    </div>
                    <div class="sport-card">
                        <div class="sport-icon">&#x1F3BE;</div>
                        <h3>Tennis</h3>
                        <p>Tennis courts and training facilities</p>
                    </div>
                    <div class="sport-card">
                        <div class="sport-icon">&#x1F3D3;</div>
                        <h3>Table Tennis</h3>
                        <p>Indoor table tennis halls</p>
                    </div>
                    <div class="sport-card">
                        <div class="sport-icon">&#x1F94A;</div>
                        <h3>Boxing</h3>
                        <p>Boxing gyms and training centers</p>
                    </div>
                    <div class="sport-card">
                        <div class="sport-icon">&#x1F3CB;&#xFE0F;</div>
                        <h3>Fitness</h3>
                        <p>Gyms and fitness centers</p>
                    </div>
                </div>
            </div>
        </section>

        <section id="about" class="about-section">
            <div class="container">
                <div class="about-content">
                    <h2>Why Khel?</h2>
                    <div class="problem-solution">
                        <div class="problem">
                            <h3>The Problem</h3>
                            <p>Booking sports venues in Nepal is complicated and inefficient. Players waste time making phone calls and sending messages on social media, often resulting in double-bookings, cancellations, and no-shows.</p>
                        </div>
                        <div class="solution">
                            <h3>Our Solution</h3>
                            <p>Khel provides a centralized, reliable platform where players can easily search, book, and pay for venues in real-time, while venue owners can manage availability and track payments efficiently.</p>
                        </div>
                    </div>
                </div>
            </div>
        </section>

        <section class="features-section">
            <div class="container">
                <h2>Features</h2>
                <div class="features-grid">
                    <div class="feature">
                        <h3>Real-time Booking</h3>
                        <p>Instantly check availability and book your preferred time slots with live updates from venue owners</p>
                    </div>
                    <div class="feature">
                        <h3>Secure Payments</h3>
                        <p>Safe and convenient online payment options with multiple payment gateways and instant confirmation</p>
                    </div>
                    <div class="feature">
                        <h3>Multi-sport Support</h3>
                        <p>One unified platform supporting 12+ sports from futsal to swimming with specialized booking features for each</p>
                    </div>
                    <div class="feature">
                        <h3>Venue Management</h3>
                        <p>Comprehensive dashboard for venue owners to manage bookings, pricing, and availability schedules</p>
                    </div>
                    <div class="feature">
                        <h3>Smart Notifications</h3>
                        <p>Get instant alerts for booking confirmations, reminders, and venue updates via SMS and email</p>
                    </div>
                    <div class="feature">
                        <h3>Location Search</h3>
                        <p>Find venues near you with advanced filters for distance, price range, facilities, and user ratings</p>
                    </div>
                </div>
            </div>
        </section>
    </main>

